PORT=3000
SUPABASE_URL=
DATABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Storage buckets (public buckets; /storage/v1 uses SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY + user JWT)
SUPABASE_MUSEUM_MEDIA_BUCKET=museum-media
SUPABASE_SOUVENIR_MEDIA_BUCKET=souvenir-media

# Optional: only needed if using an S3-compatible client instead of /storage/v1
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
