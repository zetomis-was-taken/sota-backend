PORT=3000
DATABASE_URL=
# Optional: direct or session-pooler URL (port 5432) preferred for Drizzle migrations
DIRECT_URL=

# Supabase Auth (JWT verification via supabase.auth.getUser) & Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public Storage buckets managed by Express admin media routes
SUPABASE_MUSEUM_MEDIA_BUCKET=museum-media
SUPABASE_SOUVENIR_MEDIA_BUCKET=souvenir-media

# Optional: S3-compatible credentials if uploading/deleting via an S3 client
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
